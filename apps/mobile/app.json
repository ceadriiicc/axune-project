{
  "expo": {
    "name": "Axune",
    "slug": "axune",
    "version": "0.1.0",
    "orientation": "portrait",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "icon": "./assets/images/icon.png",
    "scheme": "axune",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.cedricyeoh.axune",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Axune uses the camera to scan the pairing QR code shown by Axune Desktop.",
        "NSLocalNetworkUsageDescription": "Axune connects to Axune Desktop on your local network to run your coding agents against your own project.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.cedricyeoh.axune",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#08090d"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#08090d",
          "imageWidth": 180
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "ea3f6f91-dab5-4ba4-9d7e-11df6781450b"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/ea3f6f91-dab5-4ba4-9d7e-11df6781450b"
    }
  }
}
